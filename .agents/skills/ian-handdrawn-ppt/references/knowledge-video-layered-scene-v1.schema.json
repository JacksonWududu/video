{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-video-layered-scene-v1.schema.json",
  "title": "Ian knowledge-video layered scene package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "episode_workspace",
    "queue_item_id",
    "shot_id",
    "visual_generation_route",
    "treatment_profile_id",
    "storyboard_binding",
    "visual_direction_review",
    "canvas",
    "timing",
    "narration_source_text",
    "narration_source_text_sha256",
    "scene_plan",
    "scene_plan_sha256",
    "generation_constraints",
    "background",
    "layers",
    "final_composite",
    "verified_visible_text"
  ],
  "properties": {
    "contract_version": {"const": "ian-knowledge-video-layered-scene-v1"},
    "episode_workspace": {"type": "string", "minLength": 1},
    "queue_item_id": {"type": "string", "minLength": 1},
    "shot_id": {"type": "string", "pattern": "^S[0-9]+$"},
    "visual_generation_route": {"const": "ian-handdrawn-ppt"},
    "treatment_profile_id": {"type": "string", "minLength": 1},
    "storyboard_binding": {"$ref": "#/$defs/fileBinding"},
    "visual_direction_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "checksum_sha256", "presented_map_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "checksum_sha256": {"$ref": "#/$defs/sha256"},
        "presented_map_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": {"const": 1920},
        "height": {"const": 1080},
        "fps": {"const": 30}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_start_frame", "shot_end_frame", "duration_frames"],
      "properties": {
        "shot_start_frame": {"type": "integer", "minimum": 0},
        "shot_end_frame": {"type": "integer", "minimum": 1},
        "duration_frames": {"type": "integer", "minimum": 8}
      }
    },
    "narration_source_text": {"type": "string", "minLength": 1},
    "narration_source_text_sha256": {"$ref": "#/$defs/sha256"},
    "scene_plan": {"$ref": "#/$defs/scenePlan"},
    "scene_plan_sha256": {"$ref": "#/$defs/sha256"},
    "generation_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background_raster_count",
        "final_composite_raster_count",
        "layer_rasters_are_full_canvas_rgba",
        "scene_translation",
        "scene_scaling",
        "layer_translation",
        "layer_scaling",
        "layer_rotation",
        "mask_reveal",
        "internal_cut",
        "automatic_page_number",
        "automatic_title",
        "automatic_subtitle",
        "automatic_labels",
        "signature"
      ],
      "properties": {
        "background_raster_count": {"const": 1},
        "final_composite_raster_count": {"const": 1},
        "layer_rasters_are_full_canvas_rgba": {"const": true},
        "scene_translation": {"const": false},
        "scene_scaling": {"const": false},
        "layer_translation": {"const": false},
        "layer_scaling": {"const": false},
        "layer_rotation": {"const": false},
        "mask_reveal": {"const": false},
        "internal_cut": {"const": false},
        "automatic_page_number": {"const": false},
        "automatic_title": {"const": false},
        "automatic_subtitle": {"const": false},
        "automatic_labels": {"const": false},
        "signature": {"const": false}
      }
    },
    "background": {
      "allOf": [
        {"$ref": "#/$defs/rasterBinding"},
        {"type": "object", "properties": {
          "role": {"const": "static-paper-background"},
          "has_alpha": {"const": false}
        }}
      ]
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/layerPlan"},
          {"$ref": "#/$defs/rasterBinding"},
          {"type": "object", "properties": {
            "role": {"const": "transparent-semantic-element"},
            "has_alpha": {"const": true}
          }}
        ]
      }
    },
    "final_composite": {
      "allOf": [
        {"$ref": "#/$defs/rasterBinding"},
        {"type": "object", "properties": {
          "role": {"const": "final-composite-review-raster"},
          "has_alpha": {"const": false}
        }}
      ]
    },
    "verified_visible_text": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "checksum_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "checksum_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "entryTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "duration_frames", "easing"],
      "properties": {
        "contract_version": {"const": "ian-layer-entry-fade-v1"},
        "duration_frames": {"const": 8},
        "easing": {"const": "linear"}
      }
    },
    "motionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_transform", "layer_transform", "mask_reveal", "internal_cut", "opacity_animation"
      ],
      "properties": {
        "scene_transform": {"const": "forbidden"},
        "layer_transform": {"const": "forbidden"},
        "mask_reveal": {"const": "forbidden"},
        "internal_cut": {"const": "forbidden"},
        "opacity_animation": {"const": "ian-layer-entry-fade-v1"}
      }
    },
    "layerPlan": {
      "type": "object",
      "required": [
        "layer_id", "z_index", "semantic_role", "source_text_start_byte",
        "source_text_end_byte_exclusive", "source_text", "entry_frame"
      ],
      "properties": {
        "layer_id": {"type": "string", "pattern": "^L[0-9]{2}$"},
        "z_index": {"type": "integer", "minimum": 1},
        "semantic_role": {"type": "string", "minLength": 1},
        "source_text_start_byte": {"type": "integer", "minimum": 0},
        "source_text_end_byte_exclusive": {"type": "integer", "minimum": 1},
        "source_text": {"type": "string", "minLength": 1},
        "entry_frame": {"type": "integer", "minimum": 0}
      }
    },
    "scenePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "shot_id", "narration_source_text_sha256", "scene_renderer",
        "background_policy", "layer_asset_policy", "layer_entry_transition", "motion_policy",
        "layer_count", "layers"
      ],
      "properties": {
        "contract_version": {"const": "ian-layered-scene-plan-v1"},
        "shot_id": {"type": "string", "pattern": "^S[0-9]+$"},
        "narration_source_text_sha256": {"$ref": "#/$defs/sha256"},
        "scene_renderer": {"const": "ian-static-layered-scene-v1"},
        "background_policy": {"const": "static-paper-background-v1"},
        "layer_asset_policy": {"const": "full-canvas-transparent-png-v1"},
        "layer_entry_transition": {"$ref": "#/$defs/entryTransition"},
        "motion_policy": {"$ref": "#/$defs/motionPolicy"},
        "layer_count": {"type": "integer", "minimum": 1},
        "layers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layerPlan"}}
      }
    },
    "rasterBinding": {
      "type": "object",
      "required": ["path", "checksum_sha256", "width", "height", "role", "has_alpha"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "checksum_sha256": {"$ref": "#/$defs/sha256"},
        "width": {"const": 1920},
        "height": {"const": 1080},
        "role": {"type": "string"},
        "has_alpha": {"type": "boolean"}
      }
    }
  }
}
