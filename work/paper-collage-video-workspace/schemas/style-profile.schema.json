{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.paper-collage.dev/style-profile.schema.json",
  "title": "Executable Video Style Profile v2",
  "$defs": {
    "surfaceTexture": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["src", "opacity", "blendMode"],
          "properties": {
            "src": {"type": "string", "minLength": 1},
            "opacity": {"type": "number", "minimum": 0, "maximum": 1},
            "blendMode": {"enum": ["normal", "multiply", "screen", "overlay"]}
          },
          "additionalProperties": false
        }
      ]
    },
    "subjectEdge": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["none", "paper-outline"]},
        "color": {"type": "string", "minLength": 1},
        "widthPx": {"type": "number", "minimum": 0, "maximum": 16}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "paper-outline"}}},
          "then": {"required": ["color", "widthPx"]},
          "else": {"not": {"anyOf": [{"required": ["color"]}, {"required": ["widthPx"]}]}}
        }
      ],
      "additionalProperties": false
    },
    "subjectShadow": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["none", "drop-shadow"]},
        "offsetXPx": {"type": "number", "minimum": -32, "maximum": 32},
        "offsetYPx": {"type": "number", "minimum": -32, "maximum": 32},
        "blurPx": {"type": "number", "minimum": 0, "maximum": 48},
        "color": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "drop-shadow"}}},
          "then": {"required": ["offsetXPx", "offsetYPx", "blurPx", "color"]},
          "else": {
            "not": {
              "anyOf": [
                {"required": ["offsetXPx"]},
                {"required": ["offsetYPx"]},
                {"required": ["blurPx"]},
                {"required": ["color"]}
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "surface": {
      "type": "object",
      "required": ["texture", "subjectEdge", "subjectShadow"],
      "properties": {
        "texture": {"$ref": "#/$defs/surfaceTexture"},
        "subjectEdge": {"$ref": "#/$defs/subjectEdge"},
        "subjectShadow": {"$ref": "#/$defs/subjectShadow"}
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "required": [
        "canvas",
        "sceneBackground",
        "accent",
        "ink",
        "subtitle",
        "subtitleBackground",
        "foreground",
        "surface"
      ],
      "properties": {
        "canvas": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "sceneBackground": {"type": "string"},
        "accent": {"type": "string"},
        "ink": {"type": "string"},
        "subtitle": {"type": "string"},
        "subtitleBackground": {"type": "string"},
        "foreground": {"type": "string"},
        "surface": {"$ref": "#/$defs/surface"},
        "fontFamily": {"type": "string"},
        "fontFile": {"type": "string"}
      },
      "additionalProperties": false
    },
    "visualSfx": {
      "type": "object",
      "required": [
        "policy",
        "maxPerScene",
        "allowedKinds",
        "durationRangeSeconds"
      ],
      "properties": {
        "policy": {"enum": ["rare", "selective", "expressive"]},
        "maxPerScene": {"type": "integer", "minimum": 0, "maximum": 3},
        "allowedKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["impact", "motion"]}
        },
        "durationRangeSeconds": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "minimum": 0.1, "maximum": 1},
            {"type": "number", "minimum": 0.1, "maximum": 1}
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
      "required": ["schemaVersion", "generation", "motion", "render", "quality"],
      "properties": {
        "schemaVersion": {"const": 2},
        "generation": {
          "type": "object",
          "required": [
            "promptDirectives",
            "negativeDirectives",
            "compositionPrinciples",
            "preferredSurfaces"
          ],
          "properties": {
            "promptDirectives": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "negativeDirectives": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "compositionPrinciples": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "preferredSurfaces": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "alpha",
                  "chroma-key",
                  "opaque",
                  "layer-sheet",
                  "seamless-strip-x"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "motion": {
          "type": "object",
          "required": [
            "pacing",
            "preferredIdlePresets",
            "transitionSet",
            "visualSfx"
          ],
          "properties": {
            "pacing": {"enum": ["gentle", "playful", "measured", "dynamic"]},
            "preferredIdlePresets": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["float", "breathe", "drift", "sway", "still"]}
            },
            "transitionSet": {"enum": ["paper-story", "clean-video"]},
            "visualSfx": {"$ref": "#/$defs/visualSfx"}
          },
          "additionalProperties": false
        },
        "render": {
          "type": "object",
          "required": ["theme"],
          "properties": {
            "theme": {"$ref": "#/$defs/theme"}
          },
          "additionalProperties": false
        },
        "quality": {
          "type": "object",
          "required": [
            "requiredAssetChecks",
            "requiredCompositeChecks",
            "reviewFocus"
          ],
          "properties": {
            "requiredAssetChecks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "contains": {"const": "style-profile-conformant"},
              "items": {
                "enum": ["style-consistent", "style-profile-conformant"]
              }
            },
            "requiredCompositeChecks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "contains": {"const": "style-profile-consistent"},
              "items": {"enum": ["style-profile-consistent"]}
            },
            "reviewFocus": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "label",
        "summary",
        "catalogVersion",
        "catalogFingerprint",
        "profileFingerprint",
        "referenceImage",
        "generation",
        "motion",
        "render",
        "quality"
      ],
      "properties": {
        "schemaVersion": {"const": 2},
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "catalogVersion": {"type": "string", "minLength": 1},
        "catalogFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profileFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "referenceImage": {
          "type": "string",
          "pattern": "^style-catalog/[a-z0-9-]+\\.png$"
        },
        "generation": {
          "$ref": "#/$defs/definition/properties/generation"
        },
        "motion": {"$ref": "#/$defs/definition/properties/motion"},
        "render": {"$ref": "#/$defs/definition/properties/render"},
        "quality": {"$ref": "#/$defs/definition/properties/quality"}
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "catalogVersion",
        "profileFingerprint",
        "directives"
      ],
      "properties": {
        "schemaVersion": {"const": 1},
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "catalogVersion": {"type": "string", "minLength": 1},
        "profileFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "directives": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  }
}
