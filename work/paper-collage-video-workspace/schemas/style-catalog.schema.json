{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-collage-video.local/schemas/style-catalog.schema.json",
  "type": "object",
  "required": ["schemaVersion", "version", "canonicalSubject", "styles"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 3},
    "version": {"type": "string", "minLength": 1},
    "canonicalSubject": {"type": "string", "minLength": 1},
    "styles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "label", "summary", "image", "profile"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "image": {
            "type": "string",
            "pattern": "^style-catalog/[a-z0-9-]+\\.png$"
          },
          "profile": {
            "$ref": "https://local.paper-collage.dev/style-profile.schema.json#/$defs/definition"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
