{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.paper-collage.dev/provider-observation.schema.json",
  "title": "Provider Native Output Observation",
  "type": "object",
  "required": [
    "schemaVersion",
    "mode",
    "policyId",
    "policyFingerprint",
    "observationFingerprint",
    "sourceAttempt",
    "cells"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "mode": {"const": "provider-native-observed"},
    "policyId": {"const": "flat-v1"},
    "policyFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observationFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceAttempt": {
      "type": "object",
      "required": [
        "attemptId",
        "status",
        "quotaConsumed",
        "requestFingerprint",
        "output"
      ],
      "properties": {
        "attemptId": {"type": "string", "minLength": 1},
        "status": {"enum": ["succeeded", "rejected"]},
        "quotaConsumed": {"const": true},
        "requestFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "output": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "packageRole",
          "mode",
          "policy",
          "policyFingerprint",
          "requestedKeyColor",
          "candidateKeyColor",
          "observedKeyColor",
          "rect",
          "metrics",
          "passed",
          "reasons"
        ],
        "properties": {
          "schemaVersion": {"const": 1},
          "packageRole": {"enum": ["image", "subject", "support-front", "state"]},
          "stateId": {"type": "string", "minLength": 1},
          "mode": {"const": "provider-native-observed"},
          "policy": {"type": "object"},
          "policyFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "requestedKeyColor": {"type": "string", "pattern": "^#[0-9a-f]{6}$"},
          "candidateKeyColor": {"type": "string", "pattern": "^#[0-9a-f]{6}$"},
          "observedKeyColor": {"type": "string", "pattern": "^#[0-9a-f]{6}$"},
          "rect": {
            "type": "object",
            "required": ["left", "top", "width", "height"],
            "properties": {
              "left": {"type": "integer", "minimum": 0},
              "top": {"type": "integer", "minimum": 0},
              "width": {"type": "integer", "minimum": 2},
              "height": {"type": "integer", "minimum": 2}
            },
            "additionalProperties": false
          },
          "metrics": {
            "type": "object",
            "required": [
              "totalPixels",
              "candidatePixels",
              "coverage",
              "boundaryCoverage",
              "requestedToObservedDistance",
              "clusterP95Distance",
              "clusterP99Distance",
              "largestComponentShare",
              "foregroundP10Distance"
            ],
            "properties": {
              "totalPixels": {"type": "integer", "minimum": 1},
              "candidatePixels": {"type": "integer", "minimum": 1},
              "coverage": {"type": "number", "minimum": 0, "maximum": 1},
              "boundaryCoverage": {"type": "number", "minimum": 0, "maximum": 1},
              "requestedToObservedDistance": {"type": "number", "minimum": 0},
              "clusterP95Distance": {"type": "number", "minimum": 0},
              "clusterP99Distance": {"type": "number", "minimum": 0},
              "largestComponentShare": {"type": "number", "minimum": 0, "maximum": 1},
              "foregroundP10Distance": {"type": ["number", "null"], "minimum": 0}
            },
            "additionalProperties": false
          },
          "passed": {"const": true},
          "reasons": {"type": "array", "maxItems": 0}
        },
        "allOf": [
          {
            "if": {
              "required": ["packageRole"],
              "properties": {"packageRole": {"const": "state"}}
            },
            "then": {"required": ["stateId"]},
            "else": {"not": {"required": ["stateId"]}}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
