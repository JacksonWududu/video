{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.paper-collage.dev/quality-review-contact-sheet.schema.json",
  "title": "Paper Collage Quality Review Contact Sheet Index",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "projectSlug",
    "generatedAt",
    "sourceReport",
    "scaffoldFingerprint",
    "pages",
    "reviews"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "projectSlug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "generatedAt": {"type": "string", "format": "date-time"},
    "sourceReport": {
      "$ref": "https://local.paper-collage.dev/quality-review-scaffold.schema.json#/$defs/sourceReport"
    },
    "scaffoldFingerprint": {"$ref": "#/$defs/fingerprint"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page", "file", "sha256", "reviewIds"],
        "properties": {
          "page": {"type": "integer", "minimum": 1},
          "file": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/fingerprint"},
          "reviewIds": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "targetFingerprint", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "targetFingerprint": {"$ref": "#/$defs/fingerprint"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["relativeFile", "sha256"],
              "properties": {
                "relativeFile": {"type": "string", "minLength": 1},
                "sha256": {"$ref": "#/$defs/fingerprint"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
