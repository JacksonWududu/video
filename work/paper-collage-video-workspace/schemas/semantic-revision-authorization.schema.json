{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.paper-collage.dev/semantic-revision-authorization.schema.json",
  "title": "Human-authorized semantic storyboard revision",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "source",
    "allowedSceneIds",
    "humanNote",
    "equivalentQualityEvidence",
    "decidedAt"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "source": {
      "enum": [
        "preview-changes-requested",
        "style-review-feedback",
        "asset-production-feedback"
      ]
    },
    "allowedSceneIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "humanNote": {"type": "string", "minLength": 1},
    "equivalentQualityEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "decidedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
